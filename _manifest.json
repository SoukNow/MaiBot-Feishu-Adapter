{
  "manifest_version": 2,
  "id": "souknow.feishu-adapter",
  "version": "0.1.3",
  "name": "飞书适配器",
  "description": "直连飞书/Lark 开放平台官方 API 的长连接适配器，支持群聊与私聊的文本、@ 提及、引用回复与图片收发，不需要公网 IP 或回调地址。",
  "author": {
    "name": "SoukNow",
    "url": "https://github.com/SoukNow"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/SoukNow/MaiBot-Feishu-Adapter",
    "homepage": "https://github.com/SoukNow/MaiBot-Feishu-Adapter",
    "documentation": "https://github.com/SoukNow/MaiBot-Feishu-Adapter/blob/main/README.md",
    "issues": "https://github.com/SoukNow/MaiBot-Feishu-Adapter/issues"
  },
  "changelog": "CHANGELOG.md",
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "plug",
      "background": "#00D6C9"
    }
  },
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "1.98.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.98.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "lark-oapi",
      "version_spec": ">=1.5.0,<2"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28,<1"
    }
  ],
  "capabilities": [
    "gateway.route_message",
    "gateway.update_state"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
